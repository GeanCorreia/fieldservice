{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=fieldservice;Username=postgres;Password=postgres123;Timezone=UTC;",
    "Postgres": "Host=localhost;Port=5432;Database=fieldservice;Username=postgres;Password=postgres123;Timezone=UTC;",
    "Hangfire": "Host=localhost;Port=5432;Database=fieldservice;Username=postgres;Password=postgres123;Timezone=UTC;",
    "MongoDb": "mongodb://admin:admin123@localhost:27017/fieldservice?authSource=admin",
    "Redis": "localhost:6379,password=redis123",
    "AzureMonitor": "InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://azure.com"
  },
  "Postgres": {
    "Database": "fieldservice",
    "Host": "localhost",
    "Port": 5432,
    "User": "postgres"
  },
  "MongoDb": {
    "Database": "fieldservice"
  },
  "Redis": {
    "InstanceName": "FieldService:"
  },
  "Notification": {
    "CacheTtlDays": 3
  },
  "AzureAdB2C": {
    "Instance": "https://b2clogin.com",
    "ClientId": "seu-client-id-da-api-no-b2c",
    "Domain": "://onmicrosoft.com",
    "SignUpSignInPolicyId": "B2C_1_susi_flow",
    "Scopes": "access_as_user"
  },
  "Authentication": {
    "Provider": "AzureAdB2C",
    "Session": {
      "InactivityTimeoutInMinutes": 120,
      "TokenLifetimeInMinutes": 60,
      "CacheTtlExtraHours": 2,
      "PersistenceInactivityThresholdInMinutes": 30
    }
  },
  "AzureServiceBus": {
    "ConnectionString": "Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
  },
  "Observability": {
    "Aspire": {
      "OtlpEndpoint": "http://localhost:18889"
    }
  },
  "Queue": {
    "Hangfire": {
      "ConnectionStringName": "Hangfire",
      "SchemaName": "hangfire",
      "QueuePollIntervalSeconds": 15,
      "InvisibilityTimeoutMinutes": 30,
      "DistributedLockTimeoutMinutes": 10,
      "SchedulePollingIntervalSeconds": 15,
      "SuccessfulJobRetentionDays": 7,
      "RetryAttempts": 3,
      "RetryDelaysInSeconds": [
        60,
        300,
        900
      ],
      "WorkerCount": 0,
      "Queues": [
        "default"
      ],
      "Dashboard": {
        "Path": "/hangfire",
        "EnabledEnvironments": [
          "Development"
        ],
        "AllowAnonymousInDevelopment": true,
        "AuthorizationPolicy": "Admin"
      }
    }
  },
  "Authorization": {
    "CacheExpirationInSeconds": 86400
  },
  "BrokerOutbox": {
    "RetryJobCron": "*/5 * * * *",
    "PendingRetryIntervalMinutes": 1,
    "MaxMessageRetry" : 100,
    "MessageLockTtlSeconds": 30
  },
  "SignalR": {
    "TtlToleranceInSeconds": 30
  },
  "Storage": {
    "LocalStorageBasePath": "Storage",
    "DefaultStorageProvider": "AzureBlob",
    "ExpiryPreSignedUrlMinutes": 5,
    "StoredFileLockTtlSeconds": 30,
    "MaxParallelism": 5,
    "AzureBlob": {
      "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=your_account_name;AccountKey=your_account_key;EndpointSuffix=core.windows.net",
      "ContainerName": "fieldservice"
    },
    "LocalStorage": {
      "BasePath": "Storage"
    },
    "AmazonS3": {
      "AccessKey": "your_access_key",
      "SecretKey": "your_secret_key",
      "BucketName": "your_bucket_name",
      "Region": "us-east-1"
    },
    "GoogleCloudStorage": {
      "ProjectId": "your_project_id",
      "BucketName": "your_bucket_name",
      "CredentialsFilePath": "path/to/your/credentials.json"
    }
  }
}